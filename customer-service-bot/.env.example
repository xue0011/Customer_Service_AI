# ─────────────────────────────────────────────────────────────────────────────
# customer-service-bot 环境变量示例
# 复制为 .env 并填入实际值：cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── 店铺信息 ──────────────────────────────────────────────────────────────
SHOP_NAME=我的店铺
SHOP_ID=my_shop_001

# ── 运行环境 ────────────────────────────────────────────────────────────────
# development（开发，未设管理员令牌时放行管理端点）/ production（生产，默认拒绝）
APP_ENV=production

# ── LLM 配置 ────────────────────────────────────────────────────────────────
# 通用 LLM API Key（各 Agent 未单独配置时使用）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 售前 Agent 专用 LLM（可选，不设置则使用通用配置）
# PRESALES_LLM_MODEL=gpt-4o
# PRESALES_LLM_API_KEY=
# PRESALES_LLM_TEMPERATURE=0.7

# 售后 Agent 专用 LLM（可选）
# AFTERSALES_LLM_MODEL=gpt-4o
# AFTERSALES_LLM_API_KEY=
# AFTERSALES_LLM_TEMPERATURE=0.7

# 分类器 LLM（可选，推荐使用便宜模型）
# CLASSIFIER_LLM_MODEL=gpt-4o-mini
# CLASSIFIER_LLM_TEMPERATURE=0.1

# 护栏 LLM（可选）
# GUARDRAIL_LLM_MODEL=gpt-4o-mini
# GUARDRAIL_LLM_TEMPERATURE=0.0

# ── PostgreSQL 数据库 ───────────────────────────────────────────────────────
# P0 起使用 PostgreSQL 替代 JSON 文件与 MySQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=csbot
POSTGRES_PASSWORD=csbotpass
POSTGRES_DB=customer_service
# 测试时设为 sqlite，使用 SQLite 内存库（无需真实 PG）：DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_URL=
# 数据库连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ── Redis ───────────────────────────────────────────────────────────────────
# 用于会话缓存、分布式限流、幂等控制
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 认证授权（JWT + RBAC）──────────────────────────────────────────────────
# JWT 签名密钥：生成方式 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
# 初始管理员账号（首次迁移/种子时创建）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me-strong-password

# ── 安全配置 ────────────────────────────────────────────────────────────────
# 管理后台访问令牌（legacy，保留兼容；JWT 优先）
ADMIN_TOKEN=change-me-to-a-strong-random-token
# 速率限制：每分钟最大请求数（默认 30）
RATE_LIMIT_PER_MINUTE=30

# ── 退货政策 ────────────────────────────────────────────────────────────────
RETURN_AUTO_REVIEW_THRESHOLD=200
RETURN_ALLOWED_WINDOW_DAYS=7

# ── 记忆配置 ────────────────────────────────────────────────────────────────
MEMORY_BACKEND=file
MEMORY_DIR=./data/memory
MEMORY_MAX_CONTEXT=20

# ── 嵌入模型配置 ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-v3

# ── 审计日志 ────────────────────────────────────────────────────────────────
AUDIT_ENABLED=true
AUDIT_LOG_FILE=./logs/audit.jsonl
